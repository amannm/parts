flowchart LR
    U([User])
    CQ["CadQuery\nbuild CAD"]
    GM["Gmsh\nphysical groups + meshing"]
    IM["Import\nGmsh → DOLFINx"]
    FS["Spaces & measures"]
    MDB["MatDB\ntag → params"]
    CF["Coeff-field builder"]
    BCS["BC spec"]
    BCB["BC builder"]
    IC["IC init"]
    PHYS["UFL model"]
    STEP["Instantiate step forms"]
    ADV["Advance state"]
    ASSY["Assemble + apply BCs"]
    KSP["PETSc KSP solve"]
    OUT["Outputs"]
%% Geometry + mesh
    U -- geom_params --> CQ
    U -- " mesh_params, tag_schema " --> GM
    CQ -- cad_model --> GM
    GM -- " gmsh_mesh, cell_groups, facet_groups " --> IM
    IM -- " mesh, cell_tags, facet_tags " --> FS
    U -- space_spec --> FS
%% Materials / coefficients
    U -- mat_map --> MDB
    MDB -- mat_spec --> CF
    IM -- " mesh, cell_tags " --> CF
%% Boundary conditions
    U -- bc_map --> BCS
    BCS -- bc_spec --> BCB
    IM -- " mesh, facet_tags " --> BCB
    FS -- V --> BCB
%% IC + physics
    U -- ic_spec --> IC
    FS -- V --> IC
    U -- phys_spec --> PHYS
%% Build step forms (time loop)
    IC -- " u_n, t0 " --> STEP
    ADV -- " u_n, t, dt " --> STEP
    CF -- coeff_fields --> STEP
    FS -- " V, u, v, dx, ds " --> STEP
    BCB -- natural_terms --> STEP
    PHYS -- form_templates --> STEP
%% Linear path
    STEP -- " a_step, L_step " --> ASSY
    BCB -- dirichlet_bcs --> ASSY
    ASSY -- " A_bc, b_bc " --> KSP
    U -- solver_params --> KSP
    KSP -- " u_{n+1}, solve_info " --> ADV
%% Outputs
    ADV -- outputs --> OUT
